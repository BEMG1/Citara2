# ==============================================================================
# Variables de Entorno para Citara (Supabase)
# ==============================================================================

# URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave pública anónima de Supabase (Project Settings > API > Project API keys > anon / public)
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-key-de-supabase
# (También es compatible con el nombre VITE_SUPABASE_ANON_KEY)
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Cooldown opcional en minutos para el plan gratuito
VITE_FREE_TIER_GENERATE_COOLDOWN_MINUTES=5
